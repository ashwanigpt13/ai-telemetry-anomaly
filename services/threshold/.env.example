# Redis Configuration
REDIS_URL=redis://redis:6379

# MQTT Configuration
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_TOPIC_ANOMALY=anomalies/

# Window Configuration
ERROR_WINDOW=100

# Threshold Parameters
K=3
ALPHA=0.5
DRIFT_THRESHOLD=0.05
EPSILON=1e-6

# Global Statistics (Cold Start)
GLOBAL_MEAN=0.02
GLOBAL_STD=0.01
