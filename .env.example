# ======================
# MQTT Broker Configuration
# ======================
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883

# ======================
# Redis Configuration
# ======================
REDIS_URL=redis://redis:6379

# ======================
# Simulator Configuration
# ======================
MQTT_TOPIC_TELEMETRY_BASE=telemetry/
DEFAULT_RATE=10.0
NUM_FEATURES=3
ANOMALY_PROBABILITY=0.05
SPIKE_MAGNITUDE=2.0
NOISE_MAGNITUDE=0.5
DRIFT_MAGNITUDE=0.3
DRIFT_DURATION=300.0

# ======================
# Model Configuration
# ======================
MODEL_PATH=model.pt
INPUT_DIM=3

# ======================
# Threshold Configuration
# ======================
MQTT_TOPIC_ANOMALY=anomalies/
ERROR_WINDOW=100
K=3
ALPHA=0.5
DRIFT_THRESHOLD=0.05
EPSILON=1e-6
GLOBAL_MEAN=0.02
GLOBAL_STD=0.01

# ======================
# Ingestion Configuration
# ======================
MQTT_TOPIC_TELEMETRY=telemetry/+
MQTT_SHARE_GROUP=ingestion-group
WINDOW_SIZE=50
ENTITY_TIMEOUT_SEC=300
MODEL_SERVICE_URL=http://model:8002
THRESHOLD_SERVICE_URL=http://threshold:8003
HTTP_TIMEOUT=5.0

# ======================
# API Gateway Configuration
# ======================
# Uses MODEL_SERVICE_URL, THRESHOLD_SERVICE_URL, REDIS_URL from above
# HTTP_TIMEOUT=10.0
